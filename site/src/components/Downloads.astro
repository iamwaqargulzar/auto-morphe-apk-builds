---
import type { CatalogApp } from "../../../tool/catalog.ts";
import { mb } from "../lib";

interface Props {
  app: CatalogApp;
  compact?: boolean;
}
const { app, compact = false } = Astro.props;
const assets = app.latest?.assets ?? [];
const label: Record<string, string> = { "arm64-v8a": "64-bit", "armeabi-v7a": "32-bit" };
---
{
  assets.length ? (
    <div class="app-actions">
      {assets.map((a, i) => (
        <a class={`btn ${compact ? "sm" : ""} ${i === 0 ? "primary" : ""}`} href={a.url} download title={`${a.name} (${a.arch})`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M6 19.5h12" /></svg>
          {label[a.arch] ?? a.arch} <small>{mb(a.size)}</small>
        </a>
      ))}
    </div>
  ) : (
    <p class="faint" style="margin:0;font-size:14px">Waiting for Google Play to release the version the patches support. It builds automatically when it does.</p>
  )
}
