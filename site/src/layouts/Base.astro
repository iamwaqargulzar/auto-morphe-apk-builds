---
import "../styles/global.css";
import { catalog, project, repoUrl, requestUrl } from "../lib";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
}
const { title, description, path, jsonLd = [] } = Astro.props;
const canonical = new URL(path, project.site).toString();
const updaterUrl = catalog.updater?.url;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07070b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", project.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI assistants" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <div class="aurora" aria-hidden="true"><div class="grid-lines"></div><div class="mid"></div></div>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M6 19.5h12" /></svg>
          </span>
          {project.name}
        </a>
        <nav class="nav-links">
          <a href="/#apps">Apps</a>
          <a href="/#app" class="hide-sm">Updater</a>
          <a href="/#how" class="hide-sm">How it works</a>
          <a href="/#faq" class="hide-sm">FAQ</a>
          <a href={repoUrl} class="hide-sm">GitHub</a>
          {updaterUrl && <a class="btn sm primary" href={updaterUrl} style="color:var(--bg);margin-left:6px">Get the app</a>}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap cols">
        <div style="max-width:520px">
          <div class="brand" style="margin-bottom:10px;color:var(--text)">{project.name}</div>
          <p style="margin:0">
            Patched Android apps, built in public on GitHub Actions from the official Google Play releases.
            Not affiliated with Google, Meta, X, Reddit, Telegram, TikTok, Brave or the patch authors. Released APKs use
            third-party GPLv3 patches and ship with their NOTICE.
          </p>
        </div>
        <nav>
          <a href={repoUrl}>Source</a>
          <a href={`${repoUrl}/releases`}>Releases</a>
          <a href={`${repoUrl}/actions`}>Build logs</a>
          <a href={requestUrl}>Request an app</a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </div>
    </footer>
    <script>
      // Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))),
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      // Spotlight that follows the cursor on cards.
      document.querySelectorAll<HTMLElement>(".spot").forEach((el) =>
        el.addEventListener("pointermove", (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty("--mx", `${e.clientX - r.left}px`);
          el.style.setProperty("--my", `${e.clientY - r.top}px`);
        }),
      );
    </script>
  </body>
</html>
